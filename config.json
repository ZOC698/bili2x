{
  "deepseek_api_key": "",
  "inbox_dir": "inbox",
  "output_dir": "output",
  "subtitles_dir": "subtitles",
  "history_file": "history.md",
  "dsh_dir": "~/.dsh",
  "whisper_model": "small",
  "whisper_device": "cuda",
  "whisper_compute_type": "float16",
  "max_duration_seconds": 300,
  "whisper_vad_filter": true,
