  "whisper_initial_prompt": "咕嘎，咿呜，小家伙，小妈咪，撞头了",
  "deepseek_api_base": "https://api.deepseek.com",
  "deepseek_model": "deepseek-chat",
  "subtitle_alignment": 6,
  "subtitle_fontsize": 8,
  "subtitle_margin_v": 4,
  "subtitle_border_style": 1,
  "subtitle_outline": 0,
  "subtitle_shadow": 0,
  "subtitle_primary_colour": "&H33FFFFFF",
  "history_include_wall_clock": false
}
